## Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

## Supabase (alias for server-side)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

## Google AI (Gemini) — APENAS server-side, nunca expor no frontend
## NÃO use prefixo VITE_ pois exporia a chave no bundle JS
GEMINI_API_KEY=your-gemini-api-key-here

## Meta/Facebook OAuth & WhatsApp Cloud API (Phase 3)
## NEVER use whatsapp-web.js in production — use official Meta APIs only.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-long-lived-page-access-token
META_API_VERSION=v19.0
META_WEBHOOK_VERIFY_TOKEN=a-random-string-you-also-paste-in-meta-console
WA_PHONE_NUMBER_ID=your-whatsapp-business-phone-number-id

## OpenAI (Phase 3 — embeddings, RAG, audio)
## Server-side only. NEVER prefix with VITE_ or expose to frontend.
OPENAI_API_KEY=your-openai-api-key
AI_MODEL_EMBEDDINGS=text-embedding-3-small

## Internal service token (Phase 1+) — used for service-to-service auth
INTERNAL_SERVICE_KEY=a-long-random-secret

## CampanhaProCenarios endpoint (Phase 1+) — leave empty for stub mode
CAMPANHAPRO_CENARIOS_URL=

## TikTok Integration
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

## Admin
SUPREME_ADMIN_EMAIL=eldastito@gmail.com

## Application
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
NODE_ENV=development
