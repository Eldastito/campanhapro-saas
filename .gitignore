node_modules/

# Build (artefatos não devem ser versionados — Coolify builda do source)
dist/

# Scripts de dev/throwaway (já contiveram segredos no passado)
scratch/

# Environment variables
.env
.env.local
.env.production

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# MCP config (contém tokens sensíveis)
.mcp.json
paperclip/

# Supabase CLI cache (linked project metadata varia por máquina)
supabase/.temp/
